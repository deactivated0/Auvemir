import { LineEdit, ScrollView, ListView, TextEdit, Palette, ComboBox } from "std-widgets.slint";

export global Design {
    in-out property <bool> light: false;
    in-out property <bool> reduced: false;
    out property <color> canvas: light ? #f4f5f2 : #0b1013;
    out property <color> sidebar: light ? #e9ede8 : #0e1519;
    out property <color> surface: light ? #ffffff : #121c21;
    out property <color> raised: light ? #e6eee7 : #1b2a30;
    out property <color> hover: light ? #dce9e0 : #20343b;
    out property <color> border: light ? #d5dfd7 : #293940;
    out property <color> text: light ? #1b302c : #edf3ed;
    out property <color> muted: light ? #536962 : #a3b3b2;
    out property <color> subtle: light ? #627a71 : #8ca4a3;
    out property <color> accent: light ? #245f48 : #b4e4c8;
    out property <color> accent-soft: light ? #d8ecde : #233d33;
    out property <color> on-accent: light ? #ffffff : #10261b;
}
component ScreenHeading inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> mobile;
    property <string> shown;
    property <bool> entering: false;
    height: root.mobile ? 96px : 90px;
    init => {root.shown=root.subtitle;root.entering=!Design.reduced;}
    changed subtitle => { if(Design.reduced){root.shown=root.subtitle;root.entering=false;}else{root.entering=true;} }
    Timer { interval: 90ms; running: root.entering; repeated: false; triggered => {root.shown=root.subtitle;root.entering=false;} }
    Text { x: 0px; y: 0px; width: parent.width; height: 42px; text: root.title; color: Design.text; font-size: root.mobile ? 28px : 32px; font-weight: 700; overflow: elide; }
    Text { x: 0px; y: 49px + (root.entering && !Design.reduced ? 5px : 0px); width: parent.width; height: root.mobile ? 44px : 36px; text: root.shown; color: Design.muted; font-size: 13px; wrap: word-wrap; opacity: root.entering && !Design.reduced ? 0 : 1;
        animate y { duration: Design.reduced ? 0ms : 270ms; easing: ease-out; }
        animate opacity { duration: Design.reduced ? 0ms : 240ms; easing: ease-out; }
    }
}

component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: 0;
    in property <bool> enabled: true;
    in property <bool> continuous: true;
    callback changed();
    accessible-role: slider; accessible-value: root.value; accessible-value-minimum: root.minimum; accessible-value-maximum: root.maximum; accessible-value-step: (root.maximum - root.minimum)/100;
    height: 22px; min-width: 50px; preferred-width: 160px;
    property <float> fraction: maximum > minimum ? max(0, min(1, (value - minimum) / (maximum - minimum))) : 0;
    Rectangle { y: 9px; height: 3px; width: parent.width; border-radius: 2px; background: Design.border; }
    Rectangle { x: 0px; y: 9px; height: 3px; width: parent.width * root.fraction; border-radius: 2px; background: root.enabled ? Design.text : Design.muted; }
    Rectangle { x: (parent.width - 10px) * root.fraction; y: 5px; width: 10px; height: 10px; border-radius: 5px; background: root.enabled ? Design.text : Design.subtle; border-width: focus.has-focus ? 1px : 0px; border-color: Design.muted; }
    function move-value() { root.value = max(root.minimum, min(root.maximum, root.minimum + (touch.mouse-x / root.width) * (root.maximum - root.minimum))); if(root.continuous){root.changed();} }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if(event.text == Key.RightArrow) {root.value=min(root.maximum,root.value+(root.maximum - root.minimum)/100);root.changed();return accept;} if(event.text == Key.LeftArrow) {root.value=max(root.minimum,root.value - (root.maximum - root.minimum)/100);root.changed();return accept;} return reject; } }
    touch := TouchArea { enabled: root.enabled; pointer-event(event) => {if(event.button==PointerEventButton.left && event.kind==PointerEventKind.down){focus.focus();root.move-value();} if(event.button==PointerEventButton.left && event.kind==PointerEventKind.up && !root.continuous){root.move-value();root.changed();}} moved => {if(self.pressed){root.move-value();}} }
}

export struct TrackRow { id: string, title: string, artist: string, album: string, duration: string, favorite: bool, kind: string, downloaded: bool, artwork: image }
export struct NamedRow { id: string, title: string, subtitle: string }
export struct EqBand { name: string, gain: float }
export struct LayerRow { id: string, name: string, volume: float }
export struct LyricRow { index: int, text: string }

component LyricsView inherits Rectangle {
    in property <string> text;
    in property <[LyricRow]> rows;
    in property <int> active: -1;
    in property <bool> seekable: false;
    callback jump(int);
    background: Design.canvas;
    if root.rows.length == 0: ScrollView {
        Text { text: root.text == "" ? "Load lyrics, import an LRC file, or add your own." : root.text; color: Design.muted; wrap: word-wrap; font-size: 17px; }
    }
    if root.rows.length > 0: ListView {
        for row in root.rows: Rectangle {
            height: max(48px, line.preferred-height + 24px);
            accessible-role: button; accessible-label: row.text;
            background: focus.has-focus ? Design.raised : Design.canvas;
            line := Text { x: 8px; y: 12px; width: parent.width - 16px; text: row.text; color: row.index == root.active ? Design.text : Design.muted; font-size: row.index == root.active ? 20px : 17px; font-weight: row.index == root.active ? 600 : 400; wrap: word-wrap; }
            focus := FocusScope { enabled: root.seekable; key-pressed(event) => { if(event.text == "\n" || event.text == " "){root.jump(row.index);return accept;}return reject; } }
            TouchArea { enabled: root.seekable; clicked => {focus.focus();root.jump(row.index);} }
        }
    }
}

component Action inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> light: false;
    in property <bool> enabled: true;
    callback triggered();
    forward-focus: focus;
    accessible-role: button; accessible-label: text == "▶" ? "Play" : text == "Ⅱ" ? "Pause" : text == "♥" ? "Remove from favorites" : text == "♡" ? "Add to favorites" : text == "⚙" ? "Settings" : text;
    preferred-width: text == "▶" || text == "♥" || text == "♡" || text == "⚙" ? 36px : label.preferred-width + 24px;
    min-width: 24px;
    height: 34px;
    border-radius: 7px;
    background: !root.enabled ? Design.sidebar : root.light ? Design.accent : root.selected ? Design.accent-soft : touch.pressed ? Design.raised : touch.has-hover ? Design.hover : Design.surface;
    animate background { duration: Design.reduced ? 0ms : 130ms; }
    border-color: focus.has-focus ? Design.muted : Design.border;
    border-width: focus.has-focus ? 1px : 0px;
    label := Text { x: 0px; y: 0px; width: parent.width; height: parent.height; visible: root.text != "▶" && root.text != "♥" && root.text != "♡" && root.text != "⚙"; text: root.text; color: !root.enabled ? Design.subtle : root.light ? Design.on-accent : Design.text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    if root.text == "▶" || root.text == "♥" || root.text == "♡" || root.text == "⚙": Image {
        width: 12px; height: 12px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
        colorize: root.light ? Design.on-accent : Design.text;
        source: root.text == "⚙" ? @image-url("icons/settings.svg") : root.text == "♥" ? @image-url("icons/heart.svg") : root.text == "♡" ? @image-url("icons/heart-outline.svg") : !root.enabled ? @image-url("icons/play-disabled.svg") : root.light ? @image-url("icons/play.svg") : @image-url("icons/play-light.svg");
    }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if (event.text == "\n" || event.text == " ") { root.triggered(); return accept; } return reject; } }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.triggered(); } }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback triggered();
    accessible-role: button; accessible-label: text; accessible-action-default => {root.triggered();}
    height: 40px; border-radius: 8px;
    if root.selected: Rectangle { x: 0px; y: 12px; width: 3px; height: 16px; border-radius: 2px; background: Design.accent; }
    background: root.selected ? Design.raised : touch.has-hover ? Design.surface : Design.canvas;
    Text { x: 13px; y: 0px; width: parent.width - 26px; height: parent.height; text: root.text; overflow: elide; color: root.selected ? Design.accent : Design.muted; font-size: 13px; vertical-alignment: center; }
    focus := FocusScope { key-pressed(event) => { if(event.text == "\n" || event.text == " ") {root.triggered();return accept;}return reject;} }
    touch := TouchArea { clicked => {focus.focus();root.triggered();} }
}

component MobileTab inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected: false;
    callback triggered();
    min-width: 0px; horizontal-stretch: 1;
    background: focus.has-focus ? Design.surface : Design.canvas;
    border-radius: 5px;
    accessible-role: button; accessible-label: text; accessible-action-default => {root.triggered();}
    Image { source: root.icon; colorize: root.selected ? Design.accent : Design.muted; width: 20px; height: 20px; x: (parent.width - self.width)/2; y: 4px; }
    Text { text: root.text; color: root.selected ? Design.accent : Design.muted; font-size: 10px; horizontal-alignment: center; y: 29px; }
    focus := FocusScope { key-pressed(event) => {if(event.text == "\n" || event.text == " "){root.triggered();return accept;}return reject;} }
    TouchArea { clicked => {focus.focus();root.triggered();} }
}

component Cover inherits Rectangle {
    in property <string> title;
    in property <string> kind;
    in property <image> artwork;
    background: Design.raised; border-radius: 8px; border-width: 1px; border-color: Design.raised;
    if root.kind == "radio" || root.kind == "audiobook" || root.kind == "podcast": Text { text: root.kind == "radio" ? "◉" : root.kind == "audiobook" ? "▤" : "◌"; color: Design.muted; font-size: 28px; vertical-alignment: center; horizontal-alignment: center; }
    if root.kind != "radio" && root.kind != "audiobook" && root.kind != "podcast": Image { source: @image-url("icons/music.svg"); width: 28px; height: 28px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
    if root.artwork.width > 0: Image { source: root.artwork; image-fit: cover; width: parent.width; height: parent.height; }
}
component QuickCard inherits Rectangle {
    in property <string> symbol;
    in property <string> text;
    callback triggered();
    height: 92px; min-width: 0px; horizontal-stretch: 1; border-radius: 9px; background: touch.has-hover ? Design.border : Design.surface;
    accessible-role: button; accessible-label: text; accessible-action-default => {root.triggered();}
    VerticalLayout { padding: 10px; spacing: 8px; Rectangle { height: 28px;
        if root.symbol == "♥" || root.symbol == "♬": Image { source: root.symbol == "♥" ? @image-url("icons/heart.svg") : @image-url("icons/music-light.svg"); width: 24px; height: 24px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
        if root.symbol != "♥" && root.symbol != "♬": Text { text: root.symbol; color: Design.text; font-size: 24px; horizontal-alignment: center; }
    } Text { text: root.text; color: Design.muted; font-size: 10px; wrap: word-wrap; horizontal-alignment: center; } }
    touch := TouchArea { clicked => {root.triggered();} }
    FocusScope { key-pressed(event) => {if(event.text=="\n" || event.text==" "){root.triggered();return accept;}return reject;} }
}

export component MainWindow inherits Window {
    init => { Design.light = root.light-mode; Design.reduced = root.reduced-motion; Palette.color-scheme = root.light-mode ? ColorScheme.light : ColorScheme.dark; }
    changed light-mode => { Design.light = root.light-mode; Palette.color-scheme = root.light-mode ? ColorScheme.light : ColorScheme.dark; }
    changed reduced-motion => { Design.reduced = root.reduced-motion; }
    title: "Auvemir"; background: Design.canvas; default-font-size: 14px;
    icon: @image-url("../packaging/icons/auvemir.svg");
    preferred-width: 1180px; preferred-height: 780px; min-width: 320px; min-height: 540px;
    in property <bool> light-mode: false;
    in property <bool> reduced-motion: false;
    in property <bool> force-reduced-motion: false;
    in property <bool> loading: false;
    in property <bool> scanning: false;
    in property <bool> home-recent: false;
    in property <[string]> server-names;
    in-out property <int> active-server-index: 0;
    in-out property <int> sort-index: 0;
    in-out property <int> settings-section: 0;
    in-out property <bool> shortcut-help: false;
    callback sort-library(int);
    callback select-server(int);
    callback preference(string,bool);
    callback quit();
    in-out property <int> page: 0;
    in-out property <int> audiobook-section: 0;
    in property <[TrackRow]> tracks;
    in property <[NamedRow]> collections;
    in property <[NamedRow]> saved-playlists;
    in property <[NamedRow]> connections;
    in property <[EqBand]> eq-bands;
    in property <[LayerRow]> ambient-layers;
    in property <[NamedRow]> ambient-presets;
    in-out property <string> ambient-preset-name;
    in property <bool> ambient-playing: false;
    in property <string> heading: "Good Evening";
    in property <string> subheading: "Music for a calmer mind.";
    in property <string> status: "Import your audio to get started.";
    in property <string> current-id;
    in property <bool> has-embedded-chapters: false;
    in property <image> now-artwork;
    in property <string> now-title: "Nothing playing";
    in property <string> now-artist: "Choose a track from your library";
    in property <bool> playing: false;
    in property <bool> casting: false;
    in-out property <string> cast-address;
    in-out property <string> room-address;
    in-out property <string> room-link;
    in property <string> room-invitation;
    in property <string> room-status: "Off";
    in-out property <string> discord-app-id;
    in-out property <int> api-type:0;
    in-out property <string> api-secret;
    in-out property <int> reference-provider:0;
    in-out property <string> reference-url;
    in-out property <bool> tag-editor:false;
    in-out property <string> tag-id;
    in-out property <string> tag-title;
    in-out property <string> tag-artist;
    in-out property <string> tag-album;
    in-out property <string> tag-genre;
    in-out property <string> tag-composer;
    in property <bool> can-seek: false;
    in property <bool> can-download: false;
    in property <bool> recording: false;
    in property <bool> recording-paused: false;
    in property <float> recording-level: 0;
    in property <bool> downloading: false;
    in property <bool> current-favorite: false;
    in-out property <float> progress: 0;
    in property <string> elapsed: "0:00";
    in property <string> total: "0:00";
    in property <string> repeat-label: "Repeat off";
    in property <string> lyrics: "";
    in property <string> active-lyric;
    in property <[LyricRow]> lyric-rows;
    in property <int> active-lyric-index: -1;
    in-out property <bool> lyrics-editor: false;
    in-out property <string> lyrics-edit-id;
    in-out property <string> lyrics-draft;
    in property <int> library-count: 0;
    in property <int> page-offset: 0;
    in property <bool> next-page-enabled: false;
    in-out property <string> import-path;
    in-out property <string> feed-url;
    in-out property <string> search-query;
    in-out property <string> station-id;
    in-out property <string> station-name;
    in-out property <string> station-url;
    in-out property <string> station-country;
    in-out property <string> station-language;
    in-out property <string> station-tags;
    in-out property <string> station-logo;
    in-out property <string> playlist-name;
    in-out property <string> bookmark-name;
    in-out property <string> sleep-minutes: "30";
    in-out property <string> service-name;
    in-out property <string> service-url;
    in-out property <string> service-user;
    in-out property <string> service-secret;
    in-out property <int> service-type: 0;
    in-out property <string> sync-url;
    in-out property <string> sync-user;
    in-out property <string> sync-password;
    in-out property <string> sync-passphrase;
    in-out property <float> volume: 80;
    in-out property <float> speed: 1;
    in property <bool> native-mobile: false;
    in property <bool> native-airplay: false;
    property <bool> mobile: root.native-mobile;
    changed width => { root.mobile = root.native-mobile || root.width < 760px; }
    in-out property <bool> player-expanded: false;
    in-out property <bool> radio-editor: false;
    in-out property <bool> show-lyrics: false;
    callback navigate(int);
    callback play-track(string);
    callback action(string);
    callback import-audio(string, int);
    callback remote-search(string, int);
    callback subscribe(string, int);
    callback save-station(string, string, string, string, string, string, string);
    callback delete-station(string);
    callback edit-station(string);
    callback favorite-track(string);
    callback seek(float);
    callback set-volume(float);
    callback set-speed(float);
    callback save-playlist(string);
    callback open-collection(string);
    callback open-playlist(string);
    callback playlist-action(string, string, string);
    callback bookmark(string);
    callback set-sleep(string);
    callback files-action(string, string);
    callback configure-service(string,string,string,string,string);
    callback connect-cast(string);
    callback configure-discord(string);
    callback configure-api(string,string);
    callback import-reference(string,string);
    callback room-action(string,string);
    callback save-tags(string,string,string,string,string,string);
    callback configure-sync(string,string,string,string);
    callback set-eq(int,float);
    callback layer-volume(string,float);
    callback ambient-preset(string,string);
    callback save-lyrics(string,string);
    callback seek-lyric(string,int);

    forward-focus: shortcuts;
    shortcuts := FocusScope {
        key-pressed(event) => {
            if(event.modifiers.control || event.modifiers.meta){
                if(event.text == "f"){root.navigate(9);header-search.focus();return accept;}
                if(event.text == "o"){root.action("pick-files");return accept;}
                if(event.text == "j"){root.navigate(8);return accept;}
                if(event.text == ","){root.navigate(11);return accept;}
                if(event.text == "1"){root.navigate(0);return accept;}
                if(event.text == "2"){root.navigate(1);return accept;}
                if(event.text == "/"){root.shortcut-help=!root.shortcut-help;return accept;}
                if(event.text == "q"){root.quit();return accept;}
            }
            if(event.text == Key.Escape){root.shortcut-help=false;root.player-expanded=false;root.show-lyrics=false;root.lyrics-editor=false;root.radio-editor=false;root.tag-editor=false;return accept;}
            if(event.text == " "){root.action("toggle");return accept;}
            return reject;
        }
    HorizontalLayout {
        padding-top: root.safe-area-insets.top; padding-bottom: root.safe-area-insets.bottom; padding-left: root.safe-area-insets.left; padding-right: root.safe-area-insets.right;
        min-width: 0px; min-height: 0px;
        spacing: 0px;
        if !root.mobile: Rectangle {
            width: 212px; horizontal-stretch: 0; background: Design.canvas; border-width: 1px; border-color: Design.raised;
            VerticalLayout {
                padding: 12px; spacing: 4px;
                HorizontalLayout { height: 48px; spacing: 9px; Text { text: "◉"; color: Design.text; font-size: 20px; width: 24px; } Text { text: "Auvemir"; color: Design.text; font-weight: 700; font-size: 16px; vertical-alignment: center; } }
                NavItem { text: "⌂   Home"; selected: root.page == 0; triggered => {root.navigate(0);} }
                NavItem { text: "▤   Library"; selected: root.page == 1; triggered => {root.navigate(1);} }
                NavItem { text: "◎   Discover"; selected: root.page == 2; triggered => {root.navigate(2);} }
                NavItem { text: "◉   Radio"; selected: root.page == 5; triggered => {root.navigate(5);} }
                NavItem { text: "⌕   Search"; selected: root.page == 9; triggered => {root.navigate(9);} }
                Text { text: "YOUR AUDIO"; color: Design.subtle; font-size: 10px; height: 32px; vertical-alignment: bottom; }
                NavItem { text: "▤   Audiobooks"; selected: root.page == 3; triggered => {root.navigate(3);} }
                NavItem { text: "◌   Podcasts"; selected: root.page == 4; triggered => {root.navigate(4);} }
                NavItem { text: "≋   Ambient"; selected: root.page == 6; triggered => {root.navigate(6);} }
                NavItem { text: "◍   Recordings"; selected: root.page == 7; triggered => {root.navigate(7);} }
                Text { text: "PLAYLISTS"; color: Design.subtle; font-size: 10px; height: 32px; vertical-alignment: bottom; }
                NavItem { text: "♡   Favorites"; selected: root.page == 10; triggered => {root.navigate(10);} }
                ScrollView { min-height: 0px; vertical-stretch: 1; VerticalLayout { spacing: 4px; for p in root.saved-playlists: NavItem { text: "≡   " + p.title; selected: false; triggered => {root.open-playlist(p.id);} } Rectangle {} } }
                NavItem { text: "≡   Queue"; selected: root.page == 8; triggered => {root.navigate(8);} }
                NavItem { text: "⚙   Settings"; selected: root.page == 11; triggered => {root.navigate(11);} }
            }
        }
        VerticalLayout {
            padding: 0px; spacing: 0px;
            HorizontalLayout {
                height: 66px; padding-top: 16px; padding-bottom: 16px; padding-left: root.mobile ? 20px : 28px; padding-right: root.mobile ? 20px : 28px; spacing: 12px;
                if root.mobile: Text { text: "Auvemir"; color: Design.text; font-weight: 700; font-size: 15px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                header-search := LineEdit { visible: !root.mobile; text <=> root.search-query; placeholder-text: "Search songs, artists, podcasts, and more…"; preferred-width: 330px; height: 32px; accepted => {root.remote-search(self.text,root.page);} }
                Action { text: "Queue"; triggered => {root.navigate(8);} }
                Action { text: "⚙"; triggered => {root.navigate(11);} }
            }
            ScrollView {
                min-height: 0px; min-width: 0px; vertical-stretch: 1;
                content-width: self.width;
                VerticalLayout {
                    padding-left: root.mobile ? 20px : 28px; padding-right: root.mobile ? 20px : 28px; padding-bottom: 24px; spacing: 16px; alignment: start;
                    ScreenHeading { title: root.heading; subtitle: root.subheading; mobile: root.mobile; }
                    if root.page == 0: Rectangle {
                        height: root.mobile ? 162px : 190px; border-radius: 14px; background: Design.accent-soft;
                        HorizontalLayout { padding: root.mobile ? 18px : 26px; spacing: 20px;
                            VerticalLayout { alignment: center; spacing: 10px;
                                Text { text: "MAKE TIME FOR SOUND"; color: Design.muted; font-size: 10px; letter-spacing: 1px; }
                                Text { text: "Your music.\nYour moment."; color: Design.text; font-size: root.mobile ? 24px : 32px; font-weight: 700; }
                                Action { text: root.library-count > 0 ? "Open library" : "Add your music"; light: true; triggered => {if(root.library-count > 0){root.navigate(1);}else{root.action("pick-files");}} }
                            }
                            if root.tracks.length > 0 && !root.mobile: Cover { title: root.tracks[0].title; kind: root.tracks[0].kind; artwork: root.tracks[0].artwork; width: 138px; height: 138px; vertical-stretch: 0; }
                        }
                    }
                    if root.page == 0: HorizontalLayout { spacing: 7px;
                        Action { text: "Music"; selected: root.page == 1; triggered => {root.navigate(1);} }
                        Action { text: "Podcasts"; selected: root.page == 4; triggered => {root.navigate(4);} }
                        Action { text: "Books"; selected: root.page == 3; triggered => {root.navigate(3);} }
                        Action { text: "Radio"; selected: root.page == 5; triggered => {root.navigate(5);} }
                        if !root.mobile: Action { text: "Ambient"; selected: root.page == 6; triggered => {root.navigate(6);} }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.mobile && root.page == 0: HorizontalLayout { spacing: 8px;
                        Action { text: "Ambient mixes"; triggered => {root.navigate(6);} }
                        Action { text: "Recordings"; triggered => {root.navigate(7);} }
                        Rectangle {}
                    }
                    if root.page == 0: HorizontalLayout { spacing: 8px;
                        QuickCard { symbol: "♥"; text: "Liked Songs"; triggered => {root.navigate(10);} }
                        QuickCard { symbol: "↓"; text: "Downloaded"; triggered => {root.action("downloads");} }
                        QuickCard { symbol: "◷"; text: "Recently Played"; triggered => {root.navigate(0);} }
                        QuickCard { symbol: "♬"; text: "Your Mix"; triggered => {root.action("your-mix");} }
                    }
                    if root.page == 1 || root.page == 7 || root.page == 6: VerticalLayout { spacing: 10px;
                        HorizontalLayout { spacing: 8px;
                            Action { text: "Add files"; light: true; triggered => {root.action("pick-files");} }
                            Action { text: "Add folder"; triggered => {root.action("pick-folder");} }
                            Rectangle {}
                        }
                        if !root.native-mobile: HorizontalLayout { spacing: 8px;
                            LineEdit { text <=> root.import-path; placeholder-text: "Audio file or folder path"; height: 36px; accepted => {root.import-audio(self.text,root.page);} }
                            Action { text: "Import path"; triggered => {root.import-audio(root.import-path,root.page);} }
                        }
                    }
                    if root.page == 1: HorizontalLayout { spacing: 10px; Action { text: "Tracks"; triggered => {root.navigate(1);} } Action { text: "Albums"; triggered => {root.action("albums");} } Action { text: "Artists"; triggered => {root.action("artists");} } Rectangle {} }
                    if root.page == 2: HorizontalLayout {
                        spacing: 10px;
                        Action { text: "Trending"; triggered => {root.action("online-trending");} }
                        ComboBox { model: root.server-names; current-index <=> root.active-server-index; selected(_) => {root.select-server(self.current-index);} }
                        Rectangle {}
                    }
                    if root.page == 2: HorizontalLayout {
                        spacing: 10px;
                        LineEdit { text <=> root.search-query; placeholder-text: "Search songs & artists on YouTube Music…"; height: 36px; accepted => {root.remote-search(self.text,2);} }
                        Action { text: "Search"; triggered => {root.remote-search(root.search-query,2);} }
                    }
                    if root.page == 2: HorizontalLayout {
                        spacing: 10px;
                        LineEdit { text <=> root.feed-url; placeholder-text: "Direct audio stream URL (https://…/audio.mp3)"; height: 36px; accepted => {root.subscribe(self.text,2);} }
                        Action { text: "Open stream"; light: true; triggered => {root.subscribe(root.feed-url,2);} }
                    }
                    if root.page == 3: HorizontalLayout {
                        spacing: 10px;
                        Action { text: "Online books"; selected: root.audiobook-section == 0; triggered => {root.audiobook-section = 0; root.action("books-top");} }
                        Action { text: "Genres"; selected: root.audiobook-section == 0 && root.collections.length > 0; triggered => {root.audiobook-section = 0; root.action("books-genres");} }
                        Action { text: "Local books"; selected: root.audiobook-section == 1; triggered => {root.audiobook-section = 1; root.action("books-local");} }
                        Rectangle {}
                    }
                    if root.page == 3 && root.audiobook-section == 1: VerticalLayout { spacing: 10px;
                        HorizontalLayout { spacing: 8px;
                            Action { text: "Add files"; light: true; triggered => {root.action("pick-files");} }
                            Action { text: "Add folder"; triggered => {root.action("pick-folder");} }
                            Rectangle {}
                        }
                        if !root.native-mobile: HorizontalLayout { spacing: 8px;
                            LineEdit { text <=> root.import-path; placeholder-text: "Audiobook file or folder path"; height: 36px; accepted => {root.import-audio(self.text,3);} }
                            Action { text: "Import path"; triggered => {root.import-audio(root.import-path,3);} }
                        }
                    }
                    if root.page == 3 && root.audiobook-section == 0: HorizontalLayout {
                        spacing: 10px;
                        LineEdit { text <=> root.search-query; placeholder-text: "Search free books on LibriVox…"; height: 36px; accepted => {root.remote-search(self.text,3);} }
                        Action { text: "Search"; triggered => {root.remote-search(root.search-query,3);} }
                    }
                    if root.page == 3 && root.audiobook-section == 0: HorizontalLayout {
                        spacing: 10px;
                        LineEdit { text <=> root.feed-url; placeholder-text: "LibriVox audiobook RSS URL"; height: 36px; accepted => {root.subscribe(self.text,3);} }
                        Action { text: "Add book"; triggered => {root.subscribe(root.feed-url,3);} }
                    }
                    if root.page == 3 && root.audiobook-section == 1: HorizontalLayout {
                        spacing: 10px;
                        if !root.native-mobile: LineEdit { text <=> root.import-path; placeholder-text: "Path to local audiobook file or folder"; height: 36px; accepted => {root.import-audio(self.text,3);} }
                        Action { text: "Import"; light: true; triggered => {root.import-audio(root.import-path,3);} }
                        if !root.mobile: Action { text: "Browse files"; triggered => {root.action("pick-files");} }
                        if !root.mobile: Action { text: "Browse folder"; triggered => {root.action("pick-folder");} }
                    }
                    if root.page == 4: HorizontalLayout {
                        spacing: 10px;
                        Action { text: "Popular"; triggered => {root.action("podcasts-top");} }
                        Action { text: "Genres"; triggered => {root.action("podcasts-genres");} }
                        Action { text: "Refresh"; triggered => {root.action("refresh-feeds");} }
                        Action { text: "Following"; triggered => {root.action("subscriptions");} }
                        Rectangle {}
                    }
                    if root.page == 4: HorizontalLayout {
                        spacing: 10px;
                        LineEdit { text <=> root.feed-url; placeholder-text: "Podcast RSS or Atom feed URL"; height: 36px; accepted => {root.subscribe(self.text,4);} }
                        Action { text: "Subscribe"; triggered => {root.subscribe(root.feed-url,4);} }
                    }
                    if root.page == 4: HorizontalLayout {
                        spacing: 10px;
                        LineEdit { text <=> root.search-query; placeholder-text: "Discover podcasts worldwide…"; height: 36px; accepted => {root.remote-search(self.text,4);} }
                        Action { text: "Search"; triggered => {root.remote-search(root.search-query,4);} }
                    }
                    if root.page == 5: HorizontalLayout {
                        spacing: 10px;
                        Action { text: "Top stations"; triggered => {root.action("radio-top");} }
                        Action { text: "Countries"; triggered => {root.action("radio-countries");} }
                        Action { text: "Genres"; triggered => {root.action("radio-genres");} }
                        Rectangle {}
                    }
                    if root.page == 5 || root.page == 9: HorizontalLayout {
                        spacing: 10px;
                        LineEdit { text <=> root.search-query; placeholder-text: root.page == 5 ? "Search stations worldwide" : "Search your local library"; height: 36px; accepted => {root.remote-search(self.text,root.page);} }
                        Action { text: "Search"; triggered => {root.remote-search(root.search-query,root.page);} }
                        if root.page == 5: Action { text: "+ Station"; triggered => {root.station-id="";root.station-name="";root.station-url="";root.station-country="";root.station-language="";root.station-tags="";root.station-logo="";root.radio-editor=true;} }
                    }
                    if root.page == 7: HorizontalLayout { spacing: 10px; Action { text: root.recording ? "Stop recording" : "Record voice"; light: true; triggered => {root.action("record");} } Rectangle {} }
                    if root.page == 7 && root.recording: HorizontalLayout { spacing: 10px; Action { text: root.recording-paused ? "Resume" : "Pause"; triggered => {root.action("record-pause");} } Rectangle { height: 6px; background: Design.border; Rectangle { width: parent.width*root.recording-level; height: parent.height; background: Design.text; } } }
                    if root.page == 6: HorizontalLayout { spacing: 10px; Action { text: "White"; triggered => {root.action("noise-white");} } Action { text: "Pink"; triggered => {root.action("noise-pink");} } Action { text: "Brown"; triggered => {root.action("noise-brown");} } Action { text: "Stop"; triggered => {root.action("stop-ambient");} } Rectangle {} }
                    if root.page == 6: HorizontalLayout { spacing: 10px; Action { text: "Save mix"; triggered => {root.action("ambient-save");} } Action { text: "Restore mix"; triggered => {root.action("ambient-restore");} } if root.ambient-layers.length > 0: Action { text: root.ambient-playing ? "Pause mix" : "Resume mix"; triggered => {root.action("ambient-toggle");} } Rectangle {} }
                    if root.page == 6: HorizontalLayout { spacing: 10px; LineEdit { text <=> root.ambient-preset-name; placeholder-text: "Name this mix"; } Action { text: "Save preset"; triggered => {root.ambient-preset("save", root.ambient-preset-name);} } }
                    if root.page == 6: VerticalLayout { spacing: 8px; for preset in root.ambient-presets: HorizontalLayout { spacing: 10px; VerticalLayout { Text { text: preset.title; color: Design.text; overflow: elide; } Text { text: preset.subtitle; color: Design.muted; font-size: 11px; } } Action { text: "Restore"; triggered => {root.ambient-preset-name=preset.title;root.ambient-preset("restore",preset.id);} } Action { text: "Delete"; triggered => {root.ambient-preset("delete",preset.id);} } } }
                    if root.page == 6: VerticalLayout { spacing: 8px; for layer in root.ambient-layers: HorizontalLayout { spacing: 10px; Text { text: layer.name; color: Design.muted; vertical-alignment: center; } Slider { maximum: 100; value: layer.volume; changed => {root.layer-volume(layer.id,self.value);} } } }
                    if root.page == 7: HorizontalLayout { spacing: 10px; Action { text: "Rename / tags"; triggered => {root.action("edit-tags");} } Action { text: "Export audio"; triggered => {root.files-action("export-current",root.import-path);} } Rectangle {} }
                    if root.page == 8: HorizontalLayout {
                        spacing: 10px;
                        Action { text: "Clear"; triggered => {root.action("clear-queue");} }
                        Action { text: "Shuffle"; triggered => {root.action("shuffle");} }
                        LineEdit { text <=> root.playlist-name; placeholder-text: "Playlist name"; height: 34px; }
                        Action { text: "Save"; triggered => {root.save-playlist(root.playlist-name);} }
                    }
                    if root.page == 11: VerticalLayout {
                        spacing: 18px;
                        ComboBox { model: ["Playback and equalizer", "Appearance and motion", "Files and playlists", "Servers and scrobbling", "Metadata and lyrics", "Sync and listening rooms", "Casting and Discord"]; current-index <=> root.settings-section; }
                        if root.settings-section == 0: VerticalLayout { spacing: 16px;
                        Text { text: "Playback"; color: Design.text; font-size: 18px; font-weight: 700; }
                        HorizontalLayout { Text { text: "Playback speed"; color: Design.muted; vertical-alignment: center; } Slider { enabled: !root.casting; minimum: 0.5; maximum: 2; value <=> root.speed; changed => {root.set-speed(self.value);} } Text { text: round(root.speed * 100)/100 + "×"; color: Design.text; width: 44px; vertical-alignment: center; } }
                        Text { text: "Playback speed preserves pitch."; color: Design.muted; }
                        Text { text: "Equalizer"; color: Design.text; font-size: 18px; font-weight: 700; }
                        for band[index] in root.eq-bands: HorizontalLayout { Text { text: band.name; width: 70px; color: Design.muted; vertical-alignment: center; } Slider { enabled: !root.casting; minimum: -12; maximum: 12; value: band.gain; changed => {root.set-eq(index,self.value);} } Text { text: round(band.gain*10)/10 + " dB"; color: Design.muted; width: 60px; vertical-alignment: center; } }
                        Action { text: "Reset equalizer"; triggered => {root.action("eq-reset");} }
                        HorizontalLayout { LineEdit { text <=> root.sleep-minutes; placeholder-text: "Minutes"; height: 34px; } Action { text: "Sleep timer"; triggered => {root.set-sleep(root.sleep-minutes);} } Action { text: "Off"; triggered => {root.set-sleep("0");} } }
                        }
                        if root.settings-section == 2: VerticalLayout { spacing: 16px;
                        Text { text: "Import and export"; color: Design.text; font-size: 18px; font-weight: 700; }
                        if !root.native-mobile: LineEdit { text <=> root.import-path; placeholder-text: "File path for import/export"; height: 36px; }
                        HorizontalLayout { Action { text: "Import M3U"; triggered => {root.files-action("import-m3u",root.import-path);} } Action { text: "Export queue"; triggered => {root.files-action("export-m3u",root.import-path);} } Rectangle {} }
                        HorizontalLayout { Action { text: "Import OPML"; triggered => {root.files-action("import-opml",root.import-path);} } Action { text: "Export OPML"; triggered => {root.files-action("export-opml",root.import-path);} } Rectangle {} }
                        HorizontalLayout { Action { text: "Import radio JSON"; triggered => {root.files-action("import-radio",root.import-path);} } Action { text: "Export radio JSON"; triggered => {root.files-action("export-radio",root.import-path);} } Rectangle {} }
                        HorizontalLayout { Action { text: "Import radio M3U"; triggered => {root.files-action("import-radio-m3u",root.import-path);} } Action { text: "Export radio M3U"; triggered => {root.files-action("export-radio-m3u",root.import-path);} } Rectangle {} }
                        HorizontalLayout { Action { text: "Import LRC"; triggered => {root.files-action("import-lyrics",root.import-path);} } Action { text: "Export lyrics"; triggered => {root.files-action("export-lyrics",root.import-path);} } Rectangle {} }
                        Text { text: "Saved playlists"; color: Design.text; font-size: 18px; font-weight: 700; }
                        Action { text: "Statistics"; triggered => {root.navigate(9);root.action("analytics");} }
                        HorizontalLayout { Action { text: "Import history"; triggered => {root.files-action("import-history",root.import-path);} } Action { text: "Export history"; triggered => {root.files-action("export-history",root.import-path);} } Rectangle {} }
                        LineEdit { text <=> root.playlist-name; placeholder-text: "New playlist name for Rename"; height: 36px; }
                        for p in root.saved-playlists: HorizontalLayout { Text { text: p.title; color: Design.muted; vertical-alignment: center; } Action { text: "Rename"; triggered => {root.playlist-action("rename",p.id,root.playlist-name);} } Action { text: "Delete"; triggered => {root.playlist-action("delete",p.id,"");} } }
                        }
                        if root.settings-section == 3: VerticalLayout { spacing: 16px;
                        Text { text: "Servers and scrobbling"; color: Design.text; font-size: 18px; font-weight: 700; }
                        ComboBox { model: ["Navidrome / Subsonic", "Audiobookshelf", "WebDAV / Nextcloud", "ListenBrainz / Koito", "Last.fm", "Maloja", "Libre.fm", "Invidious"]; current-index <=> root.service-type; }
                        LineEdit { text <=> root.service-name; placeholder-text: "Connection name"; height: 36px; }
                        LineEdit { text <=> root.service-url; placeholder-text: "Server base URL, e.g. https://api.listenbrainz.org/"; height: 36px; }
                        LineEdit { text <=> root.service-user; placeholder-text: "Username (music server / WebDAV)"; height: 36px; }
                        LineEdit { text <=> root.service-secret; enabled: root.service-type != 7; input-type: password; placeholder-text: "Password or API token; Last.fm: JSON credentials"; height: 36px; }
                        Action { text: "Save connection"; triggered => {root.configure-service(root.service-type == 0 ? "subsonic" : root.service-type == 1 ? "audiobookshelf" : root.service-type == 2 ? "webdav" : root.service-type == 3 ? "listenbrainz" : root.service-type == 4 ? "lastfm" : root.service-type == 5 ? "maloja" : root.service-type == 6 ? "librefm" : "invidious",root.service-name,root.service-url,root.service-user,root.service-secret);} }
                        for c in root.connections: HorizontalLayout { Text { text: c.title + " · " + c.subtitle; overflow: elide; color: Design.muted; vertical-alignment: center; } Action { text: "Disconnect"; triggered => {root.action("disconnect:"+c.id);} } }
                        }
                        if root.settings-section == 4: VerticalLayout { spacing: 16px;
                        Text { text: "Metadata and playlist imports"; color: Design.text; font-size: 18px; font-weight: 700; }
                        HorizontalLayout { Action { text: "MusicBrainz"; triggered => {root.action("metadata-search");} } Action { text: "Recognize audio"; triggered => {root.action("metadata-recognize");} } Action { text: "Genius"; triggered => {root.action("metadata-genius");} } Rectangle {} }
                        Text { text: "Recognition sends a fingerprint and duration to AcoustID. Metadata matches are reviewed before editing tags."; color: Design.muted; wrap: word-wrap; }
                        HorizontalLayout { Action { text: "Release cover"; triggered => {root.action("metadata-cover");} } Action { text: "Artist artwork"; triggered => {root.action("metadata-fanart");} } Rectangle {} }
                        ComboBox { model: ["Genius access token","AcoustID client key","Fanart.tv API key","Spotify access token","YouTube Data API key"]; current-index <=> root.api-type; }
                        LineEdit { text <=> root.api-secret; placeholder-text: "API credential (empty removes it)"; input-type: password; height: 36px; }
                        Action { text: "Save API credential"; triggered => {root.configure-api(root.api-type==0 ? "genius" : root.api-type==1 ? "acoustid" : root.api-type==2 ? "fanart" : root.api-type==3 ? "spotify" : "youtube",root.api-secret);} }
                        ComboBox { model: ["Spotify playlist","Deezer playlist","YouTube Music playlist"]; current-index <=> root.reference-provider; }
                        LineEdit { text <=> root.reference-url; placeholder-text: "Playlist link or ID"; height: 36px; }
                        HorizontalLayout { Action { text: "Import metadata"; triggered => {root.import-reference(root.reference-provider==0 ? "spotify":root.reference-provider==1 ? "deezer":"youtube",root.reference-url);} } Action { text: "Imported playlists"; triggered => {root.action("reference-playlists");} } Rectangle {} }
                        Text { text: "Imports match tracks already available in Auvemir. Unmatched references stay attached to the playlist and resolve when matching audio is added."; color: Design.muted; wrap: word-wrap; }
                        Action { text: "Edit current track tags"; triggered => {root.action("edit-tags");} }
                        }
                        if root.settings-section == 5: VerticalLayout { spacing: 16px;
                        Text { text: "Listen Together · " + root.room-status; color: Design.text; font-size: 18px; font-weight: 700; }
                        Text { text: "Listen with friends using matching audio on each device. Share the invitation privately. Local playback controls leave the room."; color: Design.muted; wrap: word-wrap; }
                        HorizontalLayout { LineEdit { text <=> root.room-address; placeholder-text: "Host IP (empty selects automatically)"; height: 36px; } Action { text: "Host"; triggered => {root.room-action("host",root.room-address);} } }
                        if root.room-invitation != "": LineEdit { text: root.room-invitation; read-only: true; height: 36px; }
                        LineEdit { text <=> root.room-link; placeholder-text: "Paste a room invitation"; height: 36px; }
                        HorizontalLayout { Action { text: "Join"; enabled: root.room-link != ""; triggered => {root.room-action("join",root.room-link);} } Action { text: "Retry matching audio"; enabled: root.room-status=="Following"; triggered => {root.room-action("retry","");} } Action { text: "Leave"; enabled: root.room-status!="Off"; triggered => {root.room-action("leave","");} } Rectangle {} }
                        Text { text: "Encrypted sync"; color: Design.text; font-size: 18px; font-weight: 700; }
                        Text { text: "Merge favorites, playlists, listening progress and playback settings through your WebDAV file. Audio files and credentials stay on this device."; color: Design.muted; wrap: word-wrap; }
                        LineEdit { text <=> root.sync-url; placeholder-text: "WebDAV file URL (optional for encrypted file transfer)"; height: 36px; }
                        LineEdit { text <=> root.sync-user; placeholder-text: "WebDAV username"; height: 36px; }
                        LineEdit { text <=> root.sync-password; placeholder-text: "WebDAV password"; input-type: password; height: 36px; }
                        LineEdit { text <=> root.sync-passphrase; placeholder-text: "Shared sync passphrase (12+ characters)"; input-type: password; height: 36px; }
                        HorizontalLayout { Action { text: "Save sync"; triggered => {root.configure-sync(root.sync-url,root.sync-user,root.sync-password,root.sync-passphrase);} } Action { text: "Sync now"; triggered => {root.action("sync-now");} } Action { text: "Disconnect"; triggered => {root.action("sync-disconnect");} } Rectangle {} }
                        HorizontalLayout { Action { text: "Import sync"; triggered => {root.files-action("import-sync",root.import-path);} } Action { text: "Export sync"; triggered => {root.files-action("export-sync",root.import-path);} } Rectangle {} }
                        }
                        if root.settings-section == 6: VerticalLayout { spacing: 16px;
                        if !root.native-mobile: VerticalLayout {
                            Text { text: "Discord presence"; color: Design.text; font-size: 18px; font-weight: 700; }
                            Text { text: "Share music playback with your local Discord client. Enter your Discord application ID to enable it."; color: Design.muted; wrap: word-wrap; }
                            LineEdit { text <=> root.discord-app-id; placeholder-text: "Discord application ID"; height: 36px; }
                            HorizontalLayout { Action { text: "Enable presence"; triggered => {root.configure-discord(root.discord-app-id);} } Action { text: "Disable"; triggered => {root.action("discord-disconnect");} } Rectangle {} }
                        }
                        Text { text: "Casting"; color: Design.text; font-size: 18px; font-weight: 700; }
                        Text { text: root.casting ? "Connected to a Cast receiver" : "Play audio on a receiver on your private network."; color: Design.muted; wrap: word-wrap; }
                        HorizontalLayout { Action { text: "Find receivers"; triggered => {root.action("cast-discover");} } Action { text: "Disconnect"; triggered => {root.action("cast-disconnect");} } Action { text: "AirPlay"; visible: root.native-airplay; triggered => {root.action("airplay");} } Rectangle {} }
                        LineEdit { text <=> root.cast-address; placeholder-text: "Receiver IP address"; height: 36px; }
                        Action { text: "Connect receiver"; triggered => {root.connect-cast(root.cast-address);} }
                        }
                        if root.settings-section == 1: VerticalLayout {
                            spacing: 20px;
                            Text { text: "A space that feels like you"; color: Design.text; font-size: 20px; font-weight: 600; wrap: word-wrap; }
                            Text { text: "Appearance"; color: Design.muted; }
                            HorizontalLayout { spacing: 10px;
                                Action { text: "Dark"; selected: !root.light-mode; triggered => {root.preference("appearance-light",false);} }
                                Action { text: "Light"; selected: root.light-mode; triggered => {root.preference("appearance-light",true);} }
                                Rectangle {}
                            }
                            Text { text: "Motion"; color: Design.muted; }
                            HorizontalLayout { spacing: 10px;
                                Action { text: "Follow system"; selected: !root.force-reduced-motion; triggered => {root.preference("motion-reduced",false);} }
                                Action { text: "Reduce motion"; selected: root.force-reduced-motion; triggered => {root.preference("motion-reduced",true);} }
                                Rectangle {}
                            }
                            Text { text: "Short, gentle transitions. Reduced motion removes movement and fades. System preference is read at startup."; color: Design.muted; wrap: word-wrap; }
                            Action { text: "Keyboard shortcuts"; triggered => {root.shortcut-help=true;} }
                        }
                        Text { text: "Offline by default"; color: Design.text; font-size: 18px; font-weight: 700; }
                        Text { text: "No telemetry. Connections are optional. Enabled scrobblers send listening metadata and retry offline listens; secrets use your operating system's secure storage."; color: Design.muted; wrap: word-wrap; }
                        Text { text: "Auvemir 0.1 · GPL-3.0"; color: Design.subtle; }
                    }
                    if root.collections.length > 0: VerticalLayout {
                        spacing: 8px;
                        for c in root.collections: Rectangle {
                            height: 58px; border-radius: 8px; background: ct.has-hover ? Design.hover : Design.surface;
                            border-width: 1px; border-color: Design.border;
                            HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 14px;
                                Text { text: "▤"; color: Design.muted; width: 24px; font-size: 20px; vertical-alignment: center; }
                                VerticalLayout { alignment: center; spacing: 3px;
                                    Text { text: c.title; color: Design.text; font-size: 14px; font-weight: 500; overflow: elide; }
                                    Text { text: c.subtitle; color: Design.muted; font-size: 11px; overflow: elide; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: "›"; color: Design.muted; font-size: 16px; vertical-alignment: center; }
                            }
                            accessible-role: button; accessible-label: c.title; accessible-action-default => {root.open-collection(c.id);}
                            FocusScope { key-pressed(event) => {if(event.text=="\n" || event.text==" "){root.open-collection(c.id);return accept;}return reject;} }
                            ct := TouchArea { clicked => {root.open-collection(c.id);} }
                        }
                    }
                    if root.scanning: Rectangle { height: 68px; border-radius: 10px; background: Design.accent-soft;
                        HorizontalLayout { padding: 12px; spacing: 8px; Text { text: root.status; color: Design.text; wrap: word-wrap; } Action { text: "Cancel"; triggered => {root.action("cancel-import");} } }
                    }
                    if root.page == 1 || root.page == 9 || root.page == 10 || (root.page == 3 && root.audiobook-section == 1): HorizontalLayout {
                        Text { text: "Sort by"; color: Design.muted; vertical-alignment: center; }
                        ComboBox { model: ["Album", "Title", "Artist", "Duration"]; current-index <=> root.sort-index; selected(_) => {root.sort-library(self.current-index);} }
                        Rectangle {}
                    }
                    if root.page != 11: Text {
                        text: root.page == 0 ? (root.home-recent ? "Recently played" : "From your library") :
                              root.page == 8 ? "Playing Queue" :
                              root.page == 2 ? "Online collection" :
                              root.page == 3 ? (root.audiobook-section == 1 ? "Local File Audiobooks" : "LibriVox Audiobooks") :
                              root.page == 5 ? "Radio Stations" :
                              root.page == 4 ? "Podcasts" :
                              "Your Collection";
                        color: Design.text; font-size: 17px; font-weight: 600;
                    }
                    if root.tracks.length == 0 && root.collections.length == 0 && root.page != 11: Rectangle { height: 126px; border-width: 1px; border-color: Design.accent-soft; border-radius: 9px;
                        VerticalLayout { padding: 24px; spacing: 12px;
                            Text { text: root.loading ? "Finding your next listen…" : "A little quiet here"; color: Design.text; font-size: 17px; horizontal-alignment: center; }
                            Text {
                                text: root.page == 0 ? "Add your music to make this space yours." :
                                      root.page == 2 ? "Choose a connection, search, or open a direct stream." :
                                      root.page == 3 && root.audiobook-section == 1 ? "No local file audiobooks found. Use 'Browse files' or 'Browse folder' to add audiobooks." :
                                      "Import audio, add a feed, or browse a catalog to begin.";
                                color: Design.muted; wrap: word-wrap; horizontal-alignment: center;
                            }
                        }
                    }
                    if root.tracks.length > 0: VerticalLayout {
                        spacing: 4px;
                        if !root.mobile: HorizontalLayout { Text { text: "TITLE"; color: Design.subtle; font-size: 10px; } Text { text: "ALBUM"; color: Design.subtle; font-size: 10px; preferred-width: 160px; horizontal-stretch: 0; } Text { text: "TIME"; color: Design.subtle; font-size: 10px; width: 66px; } Text { text: ""; width: 76px; } }
                        for track[i] in root.tracks: Rectangle {
                            height: root.mobile ? 76px : 70px; border-radius: 6px;
                            background: track.id == root.current-id ? Design.accent-soft : row-touch.has-hover ? Design.surface : Design.sidebar;
                            border-width: 1px; border-color: track.id == root.current-id ? Design.border : #131313;
                            HorizontalLayout { spacing: 12px; padding-left: 6px; padding-right: 6px;
                                Cover { title: track.title; kind: track.kind; artwork: track.artwork; width: 44px; height: 44px; vertical-stretch: 0; }
                                VerticalLayout { alignment: center; spacing: 4px;
                                    Text { text: track.title; color: Design.text; font-size: 13px; overflow: elide; }
                                    Text { text: track.artist + (track.downloaded ? " · Offline" : ""); color: Design.muted; font-size: 11px; overflow: elide; }
                                }
                                if !root.mobile: Text { text: track.album; color: Design.muted; font-size: 12px; preferred-width: 160px; horizontal-stretch: 0; overflow: elide; vertical-alignment: center; }
                                if !root.mobile || root.page == 8: Text { text: track.duration; color: Design.muted; font-size: 11px; width: 58px; vertical-alignment: center; }
                                Action { text: track.favorite ? "♥" : "♡"; width: 32px; triggered => {root.favorite-track(track.id);} }
                                if root.page != 8: Action { text: "+"; width: 32px; triggered => {root.action("queue-add:" + track.id);} }
                                if root.page != 8 && root.page != 5 && !root.mobile: Action { text: "Next"; width: 46px; triggered => {root.action("queue-next:" + track.id);} }
                                if root.page == 8: Action { text: "↑"; width: 28px; enabled: i > 0; triggered => {root.action("queue-up:" + i);} }
                                if root.page == 8: Action { text: "↓"; width: 28px; enabled: i + 1 < root.tracks.length; triggered => {root.action("queue-down:" + i);} }
                                if root.page == 8: Action { text: "×"; width: 32px; triggered => {root.action("queue-remove:" + i);} }
                                if root.page == 5: Action { text: "⋯"; width: 32px; triggered => {root.edit-station(track.id);root.radio-editor=true;} }
                            }
                            accessible-role: button; accessible-label: track.title + " by " + track.artist;
                            accessible-action-default => {root.play-track(track.id);}
                            row-focus := FocusScope { key-pressed(event) => { if(event.text=="\n"){root.play-track(track.id);return accept;}if(event.text==" "){if(track.id==root.current-id){root.action("toggle");}else{root.play-track(track.id);}return accept;}return reject;} }
                            row-touch := TouchArea { width: parent.width - (root.page == 8 ? 168px : root.page == 5 ? 132px : !root.mobile ? 146px : 88px); clicked => {row-focus.focus();root.play-track(track.id);} }
                        }
                    }
                    if root.tracks.length == 100 || root.page-offset > 0 || root.next-page-enabled: HorizontalLayout { Action { text: "Previous page"; enabled: root.page-offset > 0; triggered => {root.action("page-prev");} } Action { text: "Next page"; enabled: root.next-page-enabled; triggered => {root.action("page-next");} } Rectangle {} }
                    Text { text: root.status; color: Design.muted; wrap: word-wrap; font-size: 12px; }
                }
            }
            Rectangle { height: 1px; background: Design.border; }
            Rectangle {
                height: root.mobile ? 76px : 90px; background: Design.sidebar;
                HorizontalLayout { width: parent.width; height: parent.height; padding: root.mobile ? 12px : 18px; spacing: 14px;
                    Cover { title: root.now-title; kind: "music"; artwork: root.now-artwork; width: 44px; height: 44px; vertical-stretch: 0; }
                    VerticalLayout { spacing: 5px; alignment: center; preferred-width: root.mobile ? 150px : 210px;
                        Text { text: root.now-title; color: Design.text; font-size: 12px; overflow: elide; }
                        Text { text: root.now-artist; color: Design.muted; font-size: 11px; overflow: elide; }
                        TouchArea { clicked => {root.player-expanded=true;} }
                    }
                    if !root.mobile: VerticalLayout { spacing: 8px;
                        HorizontalLayout { alignment: center; spacing: 12px;
                            Action { text: "Shuffle"; triggered => {root.action("shuffle");} }
                            Action { text: "|‹"; triggered => {root.action("previous");} }
                            Action { text: root.playing ? "Ⅱ" : "▶"; light: true; width: 36px; triggered => {root.action("toggle");} }
                            Action { text: "›|"; triggered => {root.action("next");} }
                            Action { text: root.repeat-label; triggered => {root.action("repeat");} }
                        }
                        HorizontalLayout { spacing: 9px; Text { text: root.elapsed; color: Design.subtle; font-size: 10px; width: 42px; vertical-alignment: center; } Slider { continuous: false; enabled: root.can-seek; minimum: 0; maximum: 1; value <=> root.progress; changed => {root.seek(self.value);} } Text { text: root.total; color: Design.subtle; font-size: 10px; width: 42px; vertical-alignment: center; } }
                    }
                    if root.mobile: Action { text: root.playing ? "Ⅱ" : "▶"; light: true; width: 38px; triggered => {root.action("toggle");} }
                    if root.mobile: Action { text: "›|"; width: 32px; triggered => {root.action("next");} }
                    if !root.mobile: Action { text: "Expand"; triggered => {root.player-expanded=true;} }
                    if !root.mobile: Slider { minimum: 0; maximum: 100; value <=> root.volume; preferred-width: 100px; horizontal-stretch: 0; changed => {root.set-volume(self.value);} }
                }
            }
            if root.mobile: Rectangle {
                height: 56px; background: Design.canvas;
                Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: Design.raised; }
                HorizontalLayout { padding-top: 5px; padding-left: 8px; padding-right: 8px; spacing: 4px;
                    MobileTab { text: "Home"; icon: @image-url("icons/home.svg"); selected: root.page == 0; triggered => {root.navigate(0);} }
                    MobileTab { text: "Library"; icon: @image-url("icons/library.svg"); selected: root.page == 1; triggered => {root.navigate(1);} }
                    MobileTab { text: "Discover"; icon: @image-url("icons/discover.svg"); selected: root.page == 2; triggered => {root.navigate(2);} }
                    MobileTab { text: "Radio"; icon: @image-url("icons/radio.svg"); selected: root.page == 5; triggered => {root.navigate(5);} }
                    MobileTab { text: "Search"; icon: @image-url("icons/search.svg"); selected: root.page == 9; triggered => {root.navigate(9);} }
                }
            }
        }
    }

    if root.player-expanded: Rectangle {
        background: Design.canvas; x: 0; y: 0; width: root.width; height: root.height;
        TouchArea {}
        ScrollView { width: parent.width; height: parent.height; content-width: self.width;
        VerticalLayout { padding: root.mobile ? 20px : 40px; padding-top: (root.mobile ? 20px : 40px) + root.safe-area-insets.top; padding-bottom: 20px + root.safe-area-insets.bottom; spacing: 18px;
            HorizontalLayout { Action { text: "⌄ Close"; triggered => {root.player-expanded=false;} } Rectangle {} Text { text: "NOW PLAYING"; color: Design.muted; vertical-alignment: center; font-size: 11px; } Rectangle {} Action { text: "Queue"; triggered => {root.player-expanded=false;root.navigate(8);} } }
            HorizontalLayout { spacing: 40px;
                VerticalLayout { spacing: 20px;
                    Cover { title: root.now-title; kind: "music"; artwork: root.now-artwork; width: root.mobile ? root.width - 40px : min(400px, (root.width - 120px) * 0.52); height: root.mobile ? min(300px,root.width - 40px) : 340px; vertical-stretch: 0; }
                    HorizontalLayout { VerticalLayout { Text { text: root.now-title; color: Design.text; font-size: 25px; font-weight: 700; overflow: elide; } Text { text: root.now-artist; color: Design.muted; font-size: 15px; overflow: elide; } } Action { text: root.current-favorite ? "♥" : "♡"; triggered => {root.action("favorite-current");} } }
                    Slider { continuous: false; enabled: root.can-seek; minimum: 0; maximum: 1; value <=> root.progress; changed => {root.seek(self.value);} }
                    HorizontalLayout { Text { text: root.elapsed; color: Design.muted; font-size: 11px; } Rectangle {} Text { text: root.total; color: Design.muted; font-size: 11px; } }
                    HorizontalLayout { alignment: center; spacing: root.mobile ? 6px : 12px; Action { text: "−15s"; enabled: root.can-seek; triggered => {root.action("back15");} } Action { text: "|‹"; triggered => {root.action("previous");} } Action { text: root.playing ? "Ⅱ" : "▶"; light: true; height: 48px; triggered => {root.action("toggle");} } Action { text: "›|"; triggered => {root.action("next");} } Action { text: "+30s"; enabled: root.can-seek; triggered => {root.action("forward30");} } }
                    HorizontalLayout { spacing: 8px; Action { text: "Lyrics"; triggered => {root.show-lyrics=!root.show-lyrics;root.action("lyrics");} } Action { text: "Bookmark"; enabled: root.can-seek; triggered => {root.bookmark(root.bookmark-name == "" ? root.elapsed : root.bookmark-name);} } Rectangle {} }
                    HorizontalLayout { spacing: 8px; if root.has-embedded-chapters: Action { text: "Chapters"; triggered => {root.player-expanded=false;root.action("book-chapters");} } Action { text: root.downloading ? "Pause download" : "Download"; enabled: root.can-download; triggered => {root.action("download");} } Rectangle {} }
                    if !root.mobile && root.show-lyrics: HorizontalLayout { Action { text: "Lyrics −0.5s"; triggered => {root.action("lyrics-earlier");} } Action { text: "Lyrics +0.5s"; triggered => {root.action("lyrics-later");} } Rectangle {} }
                    if !root.mobile && root.show-lyrics: Action { text: "Edit lyrics"; enabled: root.current-id != ""; triggered => {root.lyrics-edit-id=root.current-id;root.lyrics-draft=root.lyrics;root.lyrics-editor=true;} }
                }
                if !root.mobile: Rectangle { width: parent.width * 0.42; background: Design.canvas; VerticalLayout { spacing: 20px; Text { text: "Lyrics"; color: Design.text; font-size: 17px; } LyricsView { text: root.lyrics; rows: root.lyric-rows; active: root.active-lyric-index; seekable: root.can-seek; jump(index) => {root.seek-lyric(root.current-id,index);} } HorizontalLayout { LineEdit { text <=> root.bookmark-name; placeholder-text: "Bookmark name"; } Action { text: "Saved bookmarks"; triggered => {root.player-expanded=false;root.action("bookmarks");} } } } }
            }
            Text { text: root.status; color: Design.muted; wrap: word-wrap; }
        }
    }
    }
    if root.mobile && root.player-expanded && root.show-lyrics: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: Design.canvas;
        TouchArea {}
        VerticalLayout {
            padding-left: 24px + root.safe-area-insets.left; padding-right: 24px + root.safe-area-insets.right;
            padding-top: 16px + root.safe-area-insets.top; padding-bottom: 16px + root.safe-area-insets.bottom; spacing: 16px;
            HorizontalLayout { Action { text: "‹ Player"; triggered => {root.show-lyrics=false;} } Rectangle {} Action { text: "Edit"; enabled: root.current-id != ""; triggered => {root.lyrics-edit-id=root.current-id;root.lyrics-draft=root.lyrics;root.lyrics-editor=true;} } }
            Text { text: root.now-title; color: Design.text; font-size: 20px; font-weight: 700; overflow: elide; }
            LyricsView { text: root.lyrics; rows: root.lyric-rows; active: root.active-lyric-index; seekable: root.can-seek; vertical-stretch: 1; jump(index) => {root.seek-lyric(root.current-id,index);} }
            HorizontalLayout { Action { text: "Lyrics −0.5s"; triggered => {root.action("lyrics-earlier");} } Action { text: "Lyrics +0.5s"; triggered => {root.action("lyrics-later");} } Rectangle {} }
            Text { text: root.status; color: Design.muted; wrap: word-wrap; }
        }
    }
    if root.lyrics-editor: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: Design.canvas;
        TouchArea {}
        VerticalLayout {
            padding-left: 24px + root.safe-area-insets.left; padding-right: 24px + root.safe-area-insets.right;
            padding-top: 24px + root.safe-area-insets.top; padding-bottom: 24px + root.safe-area-insets.bottom; spacing: 16px;
            Text { text: "Edit lyrics"; color: Design.text; font-size: 24px; font-weight: 700; }
            Text { text: "Use plain text or timed LRC lines such as [01:23.45]Your words."; color: Design.muted; wrap: word-wrap; }
            TextEdit { text <=> root.lyrics-draft; min-height: 100px; vertical-stretch: 1; }
            Text { text: root.status; color: Design.muted; wrap: word-wrap; }
            HorizontalLayout { Action { text: "Save lyrics"; light: true; triggered => {root.save-lyrics(root.lyrics-edit-id,root.lyrics-draft);} } Action { text: "Cancel"; triggered => {root.lyrics-editor=false;} } Rectangle {} }
        }
    }
    if root.radio-editor: Rectangle {
        x: 0; y: 0; width: root.width; height: root.height; background: Design.canvas;
        TouchArea {}
        ScrollView { VerticalLayout { padding: 28px; spacing: 15px;
            Text { text: root.station-id == "" ? "Add custom station" : "Edit local station"; color: Design.text; font-size: 25px; font-weight: 700; }
            LineEdit { text <=> root.station-name; placeholder-text: "Station name"; height: 40px; }
            LineEdit { text <=> root.station-url; placeholder-text: "Stream URL (http or https)"; height: 40px; }
            LineEdit { text <=> root.station-country; placeholder-text: "Country"; height: 40px; }
            LineEdit { text <=> root.station-language; placeholder-text: "Language"; height: 40px; }
            LineEdit { text <=> root.station-tags; placeholder-text: "Genre / tags"; height: 40px; }
            LineEdit { text <=> root.station-logo; placeholder-text: "Logo URL (optional)"; height: 40px; }
            HorizontalLayout { Action { text: "Save station"; light: true; triggered => {root.save-station(root.station-id,root.station-name,root.station-url,root.station-country,root.station-language,root.station-tags,root.station-logo);} } Action { text: "Cancel"; triggered => {root.radio-editor=false;} } if root.station-id != "": Action { text: "Delete custom"; triggered => {root.delete-station(root.station-id);} } Rectangle {} }
            Text { text: "Edits stay in your local collection. Public directory records are never changed."; color: Design.muted; wrap: word-wrap; }
        } }
    }
    if root.tag-editor: Rectangle {
        background: Design.canvas; x: 0px; y: 0px; width: parent.width; height: parent.height;
        TouchArea { }
        ScrollView {
            width: parent.width; height: parent.height;
        VerticalLayout {
            padding: 24px; padding-top: 24px + root.safe-area-insets.top; padding-bottom: 24px + root.safe-area-insets.bottom; spacing: 16px;
            Text { text: "Edit audio tags"; color: Design.text; font-size: 24px; font-weight: 700; }
            Text { text: "Save changes to this local audio file."; color: Design.muted; wrap: word-wrap; }
            LineEdit { text <=> root.tag-title; placeholder-text: "Title"; height: 40px; }
            LineEdit { text <=> root.tag-artist; placeholder-text: "Artist"; height: 40px; }
            LineEdit { text <=> root.tag-album; placeholder-text: "Album"; height: 40px; }
            LineEdit { text <=> root.tag-genre; placeholder-text: "Genre"; height: 40px; }
            LineEdit { text <=> root.tag-composer; placeholder-text: "Composer"; height: 40px; }
            HorizontalLayout { Action { text: "Cancel"; triggered => {root.tag-editor=false;} } Action { text: "Save tags"; triggered => {root.save-tags(root.tag-id,root.tag-title,root.tag-artist,root.tag-album,root.tag-genre,root.tag-composer);} } Rectangle {} }
            Text { text: root.status; color: Design.muted; wrap: word-wrap; }
            Rectangle {}
        }
        }
    }
    if root.shortcut-help: Rectangle {
        background: Design.canvas; width: root.width; height: root.height;
        TouchArea {}
        VerticalLayout { padding: 28px; spacing: 18px;
            Text { text: "At your fingertips"; color: Design.text; font-size: 26px; font-weight: 700; wrap: word-wrap; }
            Text { text: "Ctrl / Command + F  Search\nCtrl / Command + O  Add audio\nCtrl / Command + J  Queue\nCtrl / Command + ,  Settings\nCtrl / Command + 1 / 2  Home / Library\nCtrl / Command + /  This guide\nSpace  Play or pause\nEscape  Close a panel\nCtrl / Command + Q  Quit"; color: Design.muted; font-size: 14px; wrap: word-wrap; }
            Action { text: "Close"; triggered => {root.shortcut-help=false;} }
            Rectangle {}
        }
    }
    }

}
